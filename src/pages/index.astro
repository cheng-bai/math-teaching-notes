---
import { site, principles, practices, workflow } from '../data/site';
import Math from '../components/Math.astro';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/`, Astro.site);
const categories = [...new Set(practices.map((item) => item.category))];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f0e7" />
    <meta property="og:title" content={`${site.name}｜${site.title}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{site.name}｜{site.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header wrap">
      <a class="brand" href={`${base}/`} aria-label={`${site.name}首页`}><span class="brand-mark" aria-hidden="true">∴</span><span>{site.name}<small>TEACHING NOTES</small></span></a>
      <nav aria-label="主导航"><a href="#practice">工作方向</a><a href="#example">教学小样</a><a href="#about">关于这里</a></nav>
      <span class="edition"><i aria-hidden="true"></i>{site.edition}</span>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="eyebrow">{site.englishName}</p>
          <h1 id="hero-title">{site.headline.before}<span class="accent">{site.headline.highlight}</span>，<br />{site.headline.after}<span class="period">。</span></h1>
          <p class="hero-description">{site.intro}</p>
          <div class="hero-actions"><a class="button" href="#example">打开一个教学小样 <span aria-hidden="true">↗</span></a><a class="text-link" href="#practice">看看我关注什么 <span aria-hidden="true">↓</span></a></div>
          <div class="hero-tags"><span>上海高中数学</span><span>可复核的材料</span><span>有用的轻工具</span></div>
        </div>
        <div class="hero-art reveal" aria-hidden="true">
          <div class="art-top"><span>FIELD NOTE / 001</span><span>从条件，到理解。</span></div>
          <svg viewBox="0 0 520 410" fill="none">
            <defs><pattern id="grid" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" stroke="#c9c4b6" stroke-width=".7" /></pattern></defs>
            <rect x="20" y="10" width="480" height="370" fill="url(#grid)" opacity=".5" />
            <circle cx="261" cy="210" r="137" stroke="#292e2b" stroke-width="1.4" />
            <path d="M64 298H466M261 27V372" stroke="#93968b" stroke-dasharray="4 6" />
            <path d="M124 210L345 103L345 290Z" stroke="#292e2b" stroke-width="2" />
            <path d="M124 210L345 290" stroke="#ad402b" stroke-width="3" />
            <path d="M261 210L345 103M261 210L345 290" stroke="#93968b" stroke-dasharray="4 5" />
            <circle cx="124" cy="210" r="5" fill="#ad402b" /><circle cx="345" cy="103" r="5" fill="#292e2b" /><circle cx="345" cy="290" r="5" fill="#ad402b" /><circle cx="261" cy="210" r="3" fill="#292e2b" />
            <g fill="#292e2b" font-family="Georgia, serif" font-style="italic" font-size="21"><text x="101" y="204">A</text><text x="357" y="99">B</text><text x="357" y="310">C</text><text x="265" y="233">O</text></g>
          </svg>
          <div class="art-note"><span class="note-index">①</span><span>让关键的一步，<br />从纸面上显现。</span><span class="art-caption">几何意象 · 非例题题图</span></div>
        </div>
      </section>

      <section class="principles wrap" aria-label="工作原则">
        {principles.map((item) => <article><span class="index">{item.number} /</span><h2>{item.title}</h2><p>{item.text}</p></article>)}
      </section>

      <section class="section wrap" id="practice" aria-labelledby="practice-title">
        <div class="section-heading"><div><p class="eyebrow">01 / AREAS OF PRACTICE</p><h2 id="practice-title">围绕课堂，做几件具体的事。</h2></div><p class="section-note">以下是工作方向的介绍，<br />不是已公开的作品或服务目录。</p></div>
        <div class="filters" role="group" aria-label="筛选工作方向"><button type="button" data-filter="全部" aria-pressed="true">全部 <span>{String(practices.length).padStart(2, '0')}</span></button>{categories.map((label) => <button type="button" data-filter={label} aria-pressed="false">{label}</button>)}</div>
        <p class="sr-only" id="filter-status" aria-live="polite">显示全部 {practices.length} 个工作方向</p>
        <div class="practice-grid">{practices.map((item) => <article class="practice-card" data-category={item.category}><div class="card-top"><span>{item.category} / PRACTICE</span><span>{item.number}</span></div><h3>{item.title}</h3><p>{item.text}</p><div class="card-bottom">{item.output}</div></article>)}</div>
      </section>

      <section class="example-section" id="example" aria-labelledby="example-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">02 / A SMALL TEACHING NOTE</p><h2 id="example-title">先看见关系，再写下证明。</h2></div><span class="sample-tag">本站自拟示例 · 非学生材料</span></div>
          <div class="example-grid">
            <div class="example-copy">
              <h3>绝对值的和，为什么可以先看距离？</h3>
              <p class="problem"><strong>完整题目</strong> 已知实数 <Math tex="x" />，求 <Math tex="f(x)=|x+1|+|x-1|" /> 的最小值，并求取得最小值时 <Math tex="x" /> 的取值范围。</p>
              <p>两个绝对值，分别是数轴上的动点到 −1 和 1 的距离。先移动右侧的点，观察：点在两端之间和外侧时，距离的和有什么不同？</p>
              <details class="proof"><summary>展开方法与完整解答 <span aria-hidden="true">＋</span></summary><div class="proof-content">
                <p><strong>为什么这样分？</strong> 去掉绝对值前要确定符号。两个式子分别在 −1 和 1 变号，因此以这两个点划分区间，端点也要保留。</p>
                <p>当 <Math tex="x<-1" /> 时，<Math tex="f(x)=-(x+1)-(x-1)=-2x>2" />。</p>
                <p>当 <Math tex="-1\le x\le 1" /> 时，<Math tex="f(x)=(x+1)+(1-x)=2" />。</p>
                <p>当 <Math tex="x>1" /> 时，<Math tex="f(x)=(x+1)+(x-1)=2x>2" />。</p>
                <p>综上，最小值为 <Math tex="2" />，且当且仅当 <Math tex="x\in[-1,1]" /> 时取得。</p>
                <p class="teaching-note">教学追问：取得最小值的是一个点，还是整个区间？图上的观察提供猜想，三段计算才完成对全体实数的验证。</p>
              </div></details>
            </div>
            <div class="distance-panel">
              <div class="panel-label"><span>拖动一点，看见两段距离</span><span>LIVE / 01</span></div>
              <svg class="distance-graph" viewBox="0 0 500 210" role="img" aria-labelledby="graph-title graph-desc"><title id="graph-title">数轴上的距离示意</title><desc id="graph-desc">固定点在负一和一，动点位置可以用下方滑块调整。</desc><path d="M30 134H470M462 129L470 134L462 139" stroke="currentColor" fill="none" /><path id="left-distance" d="M190 99V76H280V99" stroke="#ad402b" stroke-width="3" fill="none" /><path id="right-distance" d="M280 99V52H310V99" stroke="#55786a" stroke-width="3" fill="none" />{[-3,-2,-1,0,1,2,3].map((x) => <g><path d={`M${250+x*60} 129V139`} stroke="currentColor" /><text x={250+x*60} y="164" text-anchor="middle">{x}</text></g>)}<circle cx="190" cy="134" r="5" fill="currentColor" /><circle cx="310" cy="134" r="5" fill="currentColor" /><g id="moving-point"><circle cx="280" cy="134" r="7" fill="#ad402b" /><text x="280" y="117" text-anchor="middle">P</text></g></svg>
              <label for="point-slider" class="slider-label">动点位置 <output id="point-value" for="point-slider">x = 0.5</output></label>
              <input id="point-slider" type="range" min="-3" max="3" step="0.1" value="0.5" aria-describedby="slider-help" />
              <p id="slider-help" class="micro">可拖动，也可用键盘方向键调整。探索范围为 [−3, 3]，题目定义域是全体实数。</p>
              <div class="distance-values" aria-live="polite" aria-atomic="true"><div><span>到 −1 的距离</span><strong id="left-value">1.5</strong></div><span class="plus">+</span><div><span>到 1 的距离</span><strong id="right-value">0.5</strong></div><span class="equals">=</span><div><span>距离之和</span><strong id="sum-value">2.0</strong></div></div>
              <p class="observation" id="observation">点在两端之间，两段距离恰好拼成整段。</p>
              <noscript><p>交互需要 JavaScript；题目及完整解答仍可直接阅读。</p></noscript>
            </div>
          </div>
        </div>
      </section>

      <section class="section wrap" id="workflow" aria-labelledby="workflow-title">
        <div class="section-heading"><div><p class="eyebrow">03 / FROM SOURCE TO CLASSROOM</p><h2 id="workflow-title">不是做完文件，就算完成。</h2></div><p class="section-note">材料的终点，是下一次真实使用。</p></div>
        <ol class="workflow">{workflow.map((step, i) => <li><span class="step-number">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
        <div class="checklist-box"><div><p class="eyebrow">TAKE A CHECKLIST</p><h3>带走一份材料交付检查单。</h3><p>用一组具体检查，代替“应该没问题”。</p></div><div class="checklist-actions"><button class="button secondary" id="download-checklist" type="button">下载检查单 <span aria-hidden="true">↓</span></button><p class="micro" id="download-status" aria-live="polite">纯文本文件，不收集任何信息。</p></div></div>
      </section>

      <section class="about-section wrap" id="about" aria-labelledby="about-title"><div><p class="eyebrow">04 / ABOUT THIS SPACE</p><h2 id="about-title">一间持续整理的<br />数学工作室。</h2></div><div class="about-copy"><p>{site.about}</p><p>这里展示工作取向和可公开的小样，不放真实学生记录，也不以未经验证的数字包装教学效果。</p><details><summary>关于这份介绍的来源与边界</summary><p>{site.editorialNote}</p><p>试运行阶段已设置不被搜索引擎收录的指令；这不是访问控制，任何获得网址的人仍可打开。本站没有登录、留言、付费或访客追踪功能；托管平台仍可能保留常规访问日志。</p></details></div></section>
    </main>
    <footer class="site-footer wrap"><a class="footer-brand" href="#main">∴ {site.name}</a><p>理解 · 依据 · 实际使用</p><span>内容校订日期 {site.updated}</span></footer>
    <script>
      import { distances } from '../lib/distance.mjs';
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = document.querySelectorAll<HTMLElement>('[data-category]');
      buttons.forEach((button) => button.addEventListener('click', () => {
        const selected = button.dataset.filter;
        let count = 0;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        cards.forEach((card) => { card.hidden = selected !== '全部' && card.dataset.category !== selected; if (!card.hidden) count++; });
        document.querySelector('#filter-status')!.textContent = `显示${selected} ${count} 个工作方向`;
      }));
      const slider = document.querySelector<HTMLInputElement>('#point-slider')!;
      function updatePoint() {
        const x = Number(slider.value);
        const d = distances(x);
        const px = 250 + x * 60;
        document.querySelector('#point-value')!.textContent = `x = ${x.toFixed(1)}`;
        document.querySelector('#left-value')!.textContent = d.left.toFixed(1);
        document.querySelector('#right-value')!.textContent = d.right.toFixed(1);
        document.querySelector('#sum-value')!.textContent = d.sum.toFixed(1);
        document.querySelector('#moving-point')!.setAttribute('transform', `translate(${px-280} 0)`);
        document.querySelector('#left-distance')!.setAttribute('d', `M190 99V76H${px}V99`);
        document.querySelector('#right-distance')!.setAttribute('d', `M${px} 99V52H310V99`);
        document.querySelector('#observation')!.textContent = Math.abs(x) <= 1 ? '点在两端之间，两段距离恰好拼成整段。' : '点移到外侧，超出的那一段会在总距离中计算两次。';
      }
      slider.addEventListener('input', updatePoint);
      updatePoint();
      document.querySelector('#download-checklist')!.addEventListener('click', () => {
        const text = '数学材料交付检查单\n\n□ 原题条件、题号与必要题图完整\n□ 来源标明，作者观点与自己的判断分开\n□ 数学结论、分类边界与等号条件已复核\n□ 学生版不含答案、解析或解题提示\n□ 教师版保留完整有效推导与关键方法选择\n□ 公式真实渲染，题图可见，版面实际抽查\n□ 手机或打印场景下可读，留白适合用途\n□ 学生记录与私有材料未混入公开成品\n□ 已明确下一次使用与复测目标\n\n说明：此清单是辅助工具，不能替代逐题数学审校。\n';
        const url = URL.createObjectURL(new Blob(['\uFEFF' + text], { type: 'text/plain;charset=utf-8' }));
        const a = document.createElement('a'); a.href = url; a.download = '数学材料交付检查单.txt'; document.body.append(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        document.querySelector('#download-status')!.textContent = '已发起下载，请查看浏览器下载列表。';
      });
    </script>
  </body>
</html>
